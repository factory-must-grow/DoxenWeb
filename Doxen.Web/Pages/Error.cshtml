@page
@model ErrorModel
@{
    ViewData["Title"] = "Ошибка";
}

<h1 class="text-danger">Что-то пошло не так</h1>
<p>Мы уже знаем об ошибке. Попробуйте вернуться на главную и повторить действие.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Код запроса:</strong> <code>@Model.RequestId</code>
    </p>
}
