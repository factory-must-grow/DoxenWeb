@page
@model Doxen.Web.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Профиль";
}

<h1 class="h3 mb-4">Профиль</h1>

<div class="panel p-4 mb-4" style="max-width: 640px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Почта</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Тариф</dt>
        <dd class="col-sm-8">@(Model.PlanName ?? "—")</dd>

        <dt class="col-sm-4 mb-0">Дата регистрации</dt>
        <dd class="col-sm-8 mb-0">@(Model.MemberSince?.ToString("d MMMM yyyy") ?? "—")</dd>
    </dl>
</div>

<a asp-page="/Account/ChangePassword" class="btn btn-quiet">Сменить пароль</a>
