@page
@model Doxen.Web.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Профиль";
}

<h1>Профиль</h1>

<dl class="row">
    <dt class="col-sm-3">Почта</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Тариф</dt>
    <dd class="col-sm-9">@(Model.PlanName ?? "—")</dd>

    <dt class="col-sm-3">Дата регистрации</dt>
    <dd class="col-sm-9">@(Model.MemberSince?.ToString("d MMMM yyyy") ?? "—")</dd>
</dl>

<a asp-page="/Account/ChangePassword" class="btn btn-outline-secondary">Сменить пароль</a>
