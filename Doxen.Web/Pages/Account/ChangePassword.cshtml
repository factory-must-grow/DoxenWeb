@page
@model Doxen.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Смена пароля";
}

<h1 class="h3 mb-4">Смена пароля</h1>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="panel p-4">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Текущий пароль" />
                    <label asp-for="Input.CurrentPassword"></label>
                    <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Новый пароль" />
                    <label asp-for="Input.NewPassword"></label>
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Повторите новый пароль" />
                    <label asp-for="Input.ConfirmPassword"></label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-ink">Сменить пароль</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
